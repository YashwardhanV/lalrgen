digraph NFA {
  rankdir=LR;
  node [shape=circle, fontsize=10];
  edge [fontsize=10];
  14 [shape=doublecircle, label="14\nABB"];
  __start [shape=point]; __start -> 0;
  0 -> 1 [style=dashed, label="ε"];
  1 -> 2 [style=dashed, label="ε"];
  1 -> 8 [style=dashed, label="ε"];
  2 -> 3 [style=dashed, label="ε"];
  2 -> 5 [style=dashed, label="ε"];
  3 -> 4 [label="a"];
  4 -> 7 [style=dashed, label="ε"];
  5 -> 6 [label="b"];
  6 -> 7 [style=dashed, label="ε"];
  7 -> 2 [style=dashed, label="ε"];
  7 -> 8 [style=dashed, label="ε"];
  8 -> 9 [style=dashed, label="ε"];
  9 -> 10 [label="a"];
  10 -> 11 [style=dashed, label="ε"];
  11 -> 12 [label="b"];
  12 -> 13 [style=dashed, label="ε"];
  13 -> 14 [label="b"];
}
