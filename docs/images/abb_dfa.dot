digraph DFA {
  rankdir=LR;
  node [shape=circle, fontsize=10];
  edge [fontsize=10];
  __start [shape=point]; __start -> 0;
  0 [shape=ellipse, label="0\n{0, 1, 2, 3, 5, 8, 9}"];
  1 [shape=ellipse, label="1\n{2, 3, 4, 5, 7, 8, 9, 10, 11}"];
  2 [shape=ellipse, label="2\n{2, 3, 5, 6, 7, 8, 9}"];
  3 [shape=ellipse, label="3\n{2, 3, 5, 6, 7, 8, 9, 12, 13}"];
  4 [shape=ellipse, peripheries=2, label="4\n{2, 3, 5, 6, 7, 8, 9, 14}\nABB"];
  0 -> 1 [label="a"];
  0 -> 2 [label="b"];
  1 -> 1 [label="a"];
  1 -> 3 [label="b"];
  2 -> 1 [label="a"];
  2 -> 2 [label="b"];
  3 -> 1 [label="a"];
  3 -> 4 [label="b"];
  4 -> 1 [label="a"];
  4 -> 2 [label="b"];
}
