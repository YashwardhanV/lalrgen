digraph MinDFA {
  rankdir=LR;
  node [shape=circle, fontsize=10];
  edge [fontsize=10];
  __start [shape=point]; __start -> 0;
  0 [label="0"];
  1 [label="1"];
  2 [label="2"];
  3 [shape=doublecircle, label="3\nABB"];
  0 -> 0 [label="b"];
  0 -> 1 [label="a"];
  1 -> 1 [label="a"];
  1 -> 2 [label="b"];
  2 -> 1 [label="a"];
  2 -> 3 [label="b"];
  3 -> 0 [label="b"];
  3 -> 1 [label="a"];
}
