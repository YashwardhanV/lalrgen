# calc.lg: arithmetic calculator.
# The expr rules are ambiguous on purpose; %left / %right / %prec resolve every conflict.
%token NUM   /[0-9]+(\.[0-9]+)?/
%token ID    /[a-zA-Z_][a-zA-Z0-9_]*/
%skip        /[ \t\r\n]+/
%skip        /#[^\n]*/

%left  '+' '-'
%left  '*' '/' '%'
%right UMINUS
%right '^'
%start program

%%

program : stmts                   -> Program($1)
        ;

stmts   : stmt                    -> List($1)
        | stmts stmt              -> List($1, $2)
        ;

stmt    : ID '=' expr ';'         -> Assign(Var($1), $3)
        | expr ';'                -> Print($1)
        ;

expr    : expr '+' expr           -> Add($1, $3)
        | expr '-' expr           -> Sub($1, $3)
        | expr '*' expr           -> Mul($1, $3)
        | expr '/' expr           -> Div($1, $3)
        | expr '%' expr           -> Mod($1, $3)
        | expr '^' expr           -> Pow($1, $3)
        | '-' expr %prec UMINUS   -> Neg($2)
        | '(' expr ')'            -> $2
        | NUM                     -> Num($1)
        | ID                      -> Var($1)
        ;
